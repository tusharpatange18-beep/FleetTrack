# Copy to local.env (git-ignored) and fill in. Used by `docker compose --env-file local.env`
# and by the PowerShell snippet in the README for running the app on your machine.
DB_URL=jdbc:mysql://localhost:3306/fleettrack?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=fleettrack_user
DB_PASSWORD=change_me
# Base64-encoded, at least 256 bits. Generate with: openssl rand -base64 32
JWT_SECRET=
MYSQL_USER=fleettrack_user
MYSQL_PASSWORD=change_me
MYSQL_ROOT_PASSWORD=change_me_root
# dev = SQL + debug logging, prod = Swagger off
SPRING_PROFILES_ACTIVE=dev
# Comma-separated browser origins allowed to call the API (empty = none)
CORS_ALLOWED_ORIGINS=http://localhost:5173
